# Webhooks do n8n para a Pentaminó
# Cole aqui os URLs de Webhook de produção gerados pelo seu n8n:

# Webhook do Agente de Chat (Chat Trigger ou Webhook Node)
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL=https://n8n.suaempresa.com.br/webhook/pentamino-chat

# Webhook de Captura de Leads (Formulário de Contato / Diagnóstico)
NEXT_PUBLIC_N8N_LEAD_WEBHOOK_URL=https://n8n.suaempresa.com.br/webhook/pentamino-lead

